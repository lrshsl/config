import ./zed_keybind


file [..

   mode i [ bind 't n' -> [zed vim::NormalBefore] ]
   mode t [ bind 't n' -> [zed terminal_panel::Toggle] ]

   mode n [..

      | Zed commands
      bind 'space t' -> [zed terminal_panel::Toggle]
      bind 'space f f' -> [zed file_finder::Toggle]

      | Panes
      bind 'space h' -> [zed workspace::ActivatePaneLeft]
      bind 'space n' -> [zed workspace::ActivatePaneDown]
      bind 'space e' -> [zed workspace::ActivatePaneUp]
      bind 'space i' -> [zed workspace::ActivatePaneRight]

      bind 'space w' -> [zed workspace::Save]
      bind 'space ; w' -> [zed workspace::SaveAll]
      bind 'space q' -> [zed pane::CloseActiveItem]

      bind 'l' -> [vim InsertBefore]
      bind 'L' -> [vim InsertFirstNonWhitespace]
      bind 'M' -> [vim JoinLines]
      bind 'j' -> [vim MoveToNextMatch]
      bind 'J' -> [vim MoveToPreviousMatch]

      | Repl
      bind 'shift-enter' -> [zed repl::RunInPlace]
      bind 'ctrl-backspace' -> [zed repl::ClearCurrentOutput]
   ..]

   | Normal or visual mode
   mode nv [..
      bind 'n' -> [vim Down]
      bind 'N' -> [keys '5 n']
      bind 'e' -> [vim Up]
      bind 'E' -> [keys '5 e']
      bind 'i' -> [vim Right]
      bind 'I' -> [vim EndOfLine]
      bind 'H' -> [vim StartOfLine]
      bind 'k' -> [vim NextWordEnd]
      bind 'K' -> [vim NextWordEnd ignore_punctuation='true']
   ..]

   mode WorkspaceOrAgent [
      bind 'ctrl-shift-e' -> [zed project_panel::Toggle]
   ]

..]

