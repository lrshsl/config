
[global]
    origin = top-right
    width = 300
    height = 300
    frame_width = 0

    corner_radius = 0
    transparency = 30 # 0..=100

    scale = 2.0

    title = Dunst
    class = Dunst

[urgency_low]
    background = "#222222"
    foreground = "#888888"
    timeout = 2

[urgency_normal]
    background = "#282c34"
    foreground = "#bbc2cf"
    timeout = 3

[urgency_critical]
    background = "#ff6c6b"
    foreground = "#ffffff"
    timeout = 0 # Never

# vim: ft=cfg
