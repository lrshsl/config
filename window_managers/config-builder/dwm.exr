
map set [name:ident] = [value] (color) =>
   '..static const char [name]\[\] = [__stringify value];..'

map set [name:ident] = [value] ([type] array) =>
   '..static const [is type { 'bool'? 'int', _? type, }] [name]\[\] = [__stringify value];..'

map set [name:ident] = [value] ([type]) =>
   '..static const [is type { 'bool'? 'int', _? type, }] [name] = [__stringify value];..'

map rule class == [class]: [mode:ident] => [
   rule class == [class]: [mode], tag = 0
]
map rule class == [class]: [mode:ident], tag = [tagn] => '..
{
   .class = "[class]",
   .instance = NULL,
   .title = NULL,
   .tags = [__stringify tagn] << 8,
   .isfloating = [is mode { 'float' ? '1', _ ? '0', }],
   .isfullscreen = [is mode { 'fullscreen' ? '1', _ ? '0', }],
   .monitor = -1
},
..'

map true => '1'
map false => '0'

| /usr/include/X11/X.h:221
map shift => 'ShiftMask'
map lock => 'LockMask'
map control => 'ControlMask'
map alt => [mod 1]
map ralt => [mod 5]
map super => [mod 4]
map mod [n] => 'Mod[__stringify n]Mask'

| /usr/include/X11/keysymdef.h
| /usr/include/X11/XF86keysym.h
map translate [key] => [is key {
   'space' ? 'space',
   'return' ? 'Return',
   'tab' ? 'Tab',
   'comma' ? 'comma',
   'period' ? 'period',
   'esc' ? 'Escape',

	'up' ? 'Up',
	'right' ? 'Right',
	'down' ? 'Down',
	'left' ? 'Left',

   _ ? '[key]'
}]


map bind: [key:ident] -> [cmd]
=> '\t{0, [key], [cmd]},'

map bind: [mod] [mod2] [key:ident] -> [cmd]
=> '\t{[mod] | [mod2], XK_[translate key], [cmd]},'

map bind: [mod] [key:ident] -> [cmd]
=> '\t{[mod], XK_[translate key], [cmd]},'

|map bind: [mod] [key] -> [cmd]
|=> '\t{[mod], XK_[translate [__stringify key]], [cmd]},'

map goto tag [n] => 'view, {.ui = 1 << [__stringify n]}'
map move window to tag [n] => 'tag, {.ui = 1 << [__stringify n]}'

map dwm [cmd:ident] => '[cmd], {0}'
map dwm [cmd:ident] [arg] => '[cmd], {. [arg]}'
map setlayout [layout:ident] => '..setlayout, {.v = &layouts\[[is layout {
   'tiled'    ? '0',
   'floating' ? '1',
   'monocle'  ? '2',
}]\]}..'

map cmd run [name:ident] => 'spawn, {.v = cmd_[name]}'
map cmd define [name:ident] = [cmd_parts] => '..
static const char *cmd_[name]\[\] = {
   [cmd_parts],
   NULL,
};
..'

map file
   settings [settings]
   colors [colors]
   window rules [rules]
   define [cmds]
   keys [keybinds]
=> '..
/* See LICENSE file for copyright and license details. */

#ifndef DWM_CONFIG_H
#define DWM_CONFIG_H

#include <unistd.h>
#include <X11/XF86keysym.h>

#include "dwm.h"

/* appearance */
[settings]

static const char *colors\[\]\[3\] = {
	[colors]
};

/* tagging */
static const char *tags\[\] = {"1", "2", "3", "4", "5", "6", "7", "8", "9"};

static const Rule rules\[\] = {
	[rules]
};

/* layout(s) */

static const Layout layouts\[\] = {
	/* symbol     arrange function */
	{"T", tile   }, /* first entry is default */
	{"F", NULL   }, /* no layout function means floating behavior */
	{"M", monocle},
};

/* commands */
static char dmenumon\[2\] =
	"0"; /* component of dmenucmd, manipulated in spawn() */
[cmds]

static const Key keys\[\] = {
   [keybinds]
};

/* button definitions */
/* click can be ClkTagBar, ClkLtSymbol, ClkStatusText, ClkWinTitle,
 * ClkClientWin, or ClkRootWin */
static const Button buttons\[\] = {
	/* click                event mask      button          function argument */
	{ClkLtSymbol,   0,      Button1, setlayout,      {0}               },
	{ClkLtSymbol,   0,      Button3, setlayout,      {.v = &layouts\[2\]}},
	{ClkWinTitle,   0,      Button2, zoom,           {0}               },
	//{ClkStatusText, 0,      Button2, spawn,          {.v = termcmd}    },
	{ClkClientWin,  [super], Button1, movemouse,      {0}               },
	{ClkClientWin,  [super], Button2, togglefloating, {0}               },
	{ClkClientWin,  [super], Button3, resizemouse,    {0}               },
	{ClkTagBar,     0,      Button1, view,           {0}               },
	{ClkTagBar,     0,      Button3, toggleview,     {0}               },
	{ClkTagBar,     [super], Button1, tag,            {0}               },
	{ClkTagBar,     [super], Button3, toggletag,      {0}               },
};

#endif /* DWM_CONFIG_H */
..'
