import ./common/utils
import ./dwm/*

map tag [key:ident] [n] => [..
   bind: ralt [key] -> [goto tag [calc n - 1]]
   bind: ralt shift [key] -> [move window to tag [calc n - 1]]
..]

map window [dir:ident] => '.\
focusstack, {.i = [
   is dir {
      'next' ? '+1',
      'prev' ? '-1',
   }
]}.'

[file
   settings '[..
      set borderpx = 1             ('unsigned int')
      set snap = 32                ('unsigned int')
      set showbar = [false]        ('bool')
      set topbar = [true]          ('bool')
      set mfact = '0.55'           ('float')
      set nmaster = [true]         ('bool')
      set resizehints = [true]     ('bool')
      set lockfullscreen = [true]  ('bool')
      set refreshrate = 120        ('int')
      set fonts = '{"monospace:size=12"}' ('char*' array)
      set dmenufont = '"monospace:size=12"' ('char' array)
      set col_gray1 = '"#222222"' (color)
      set col_gray2 = '"#444444"' (color)
      set col_gray3 = '"#bbbbbb"' (color)
      set col_gray4 = '"#eeeeee"' (color)
      set col_cyan  = '"#005555"' (color)
   ..]'

   colors '.
      /*               fg         bg         border   */
      \[SchemeNorm\] = {col_gray3, col_gray1, col_gray2},
      \[SchemeSel\] = {col_gray4, col_cyan,  col_cyan },
   .'

   window rules '.
      [[..
            rule class == 'Gimp': float
            rule class == 'Ghostty': fullscreen
            rule class == 'kitty': fullscreen
            rule class == 'Firefox': fullscreen
            rule class == 'Vivaldi-stable': fullscreen, tag = 2
      ..]]
  .'

   define '[..
      cmd define dmenu = [common/utils/dmenu default]
      cmd define main_term = '"kitty"'
      cmd define secondary_term = '"xfce4-terminal"'
|
      cmd define xkill = '"xkill"'
      cmd define visual = '"neovide"'
|
      cmd define reset_monitors = '"xrandr", "--auto"'
      cmd define connect_monitor = '"connect_monitor_x11"'
      cmd define tty_next = '"switch-tty"'
      cmd define tty_prev = '"switch-tty", "-rev"'
      cmd define i3lock = '"i3lock", "-c", "000000"'
|
      cmd define brightness_up = [common/utils/brightness up 5]
      cmd define brightness_down = [common/utils/brightness down 5]
|
      cmd define audio_up = [common/utils/audio up 5]
      cmd define audio_down = [common/utils/audio down 5]
      cmd define audio_mute = [common/utils/audio mute 'toggle']
   ..]'

   keys '..
      [..
         bind: alt space -> [cmd run dmenu]
         bind: alt return -> [cmd run main_term]
         bind: super return -> [cmd run secondary_term]
         bind: alt right -> [cmd run tty_next]
         bind: alt left -> [cmd run tty_prev]

         bind: ralt n -> [window prev]
         bind: ralt o -> [window next]

         bind: ralt c -> [dwm killclient]

         bind: ralt equal -> [dwm zoom]
         bind: ralt m -> [dwm togglefullscreen]

         bind: super b -> [dwm togglebar]
         bind: super w -> [cmd run reset_monitors]
         bind: super c -> [cmd run connect_monitor]
         bind: super z -> [cmd run i3lock]
         |bind: super n -> [cmd run visual]
         bind: super esc -> [cmd run xkill]

         bind: super r -> [dwm setmfact 'f = -0.05']
         bind: super s -> [dwm setmfact 'f = +0.05']
         bind: super t -> [setlayout tiled]
         bind: ralt t -> [setlayout tiled]
         bind: super f -> [setlayout floating]
         bind: super m -> [setlayout monocle]
         bind: super comma -> [dwm focusmon 'i = -1']
         bind: super period -> [dwm focusmon 'i = +1']

         bind: XF86XK_MonBrightnessUp -> [cmd run brightness_up]
         bind: XF86XK_MonBrightnessDown -> [cmd run brightness_down]

         bind: XF86XK_AudioRaiseVolume -> [cmd run audio_up]
         bind: XF86XK_AudioLowerVolume -> [cmd run audio_down]
         bind: XF86XK_AudioMute -> [cmd run audio_mute]

         bind: alt tab -> [dwm view]
         bind: super shift q -> [dwm quit]
         bind: super q -> [dwm setlayout]
         bind: super shift space -> [dwm togglefloating]

         tag a 1
         tag r 2
         tag s 3
         tag t 4
|
         tag q 5
         tag w 6
         tag f 7
         tag p 8
         tag g 9
      ..]

      {[super],           XK_0,      view,      {.ui = ~0} },
      {[super] | [shift], XK_0,      tag,       {.ui = ~0} },
      {[super] | [shift], XK_comma,  tagmon,    {.i  = -1} },
      {[super] | [shift], XK_period, tagmon,    {.i  = +1 } },
   ..'
]

