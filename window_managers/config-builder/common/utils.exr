
map brightness [action:ident] [val] => '..\
   "brightnessctl", "s", "[is action {
      'up' ? '+[val]%',
      'down' ? '[val]%-',
   }]"
..'

map dmenu default => '.
"dmenu_run",
   "-m",  dmenumon,
   "-fn", dmenufont,
   "-nb", col_gray1,
   "-nf", col_gray3,
   "-sb", col_cyan,
   "-sf", col_gray4
.'

map audio [action:ident] [val] => '..\
   "wpctl",
   "set-[is action {
      'mute' ? 'mute',
      _ ? 'volume'
   }]",
   "@DEFAULT_SINK@",
   "[is action {
      'mute' ? 'toggle',
      'up' ? '[val]%+',
      'down' ? '[val]%-',
   }]"
..'
