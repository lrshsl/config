
| Find more keys: https://github.com/leftwm/lefthk/blob/main/lefthk-core/src/xkeysym_lookup.rs#L50

map ret => 'Return'
map space => 'space'
map dot => 'period'
map comma => 'comma'
map esc => 'Escape'
map backspace => 'BackSpace'

map arrow up => 'Up'
map arrow right => 'Right'
map arrow down => 'Down'
map arrow left => 'Left'
|map arrow [direction:ident] => [is direction {
|   'up' ? 'Up',
|   'left' ? 'Left',
|   'down' ? 'Down',
|   'right' ? 'Right',
|}]

map translate [keyname] => [is keyname {
   'shift'? '"Shift"',
   'ctrl' ? '"Control"',

   'meta'? '"Mod1"',
   'alt' ? '"Mod1"',

   'super'  ? '"Mod4"',
   'windows'? '"Mod4"',

   'meh'  ? [translate 'ctrl' 'shift' 'meta'],
   'hyper'? [translate 'ctrl' 'shift' 'meta' 'super'],
}]

map translate [k1] [k2] =>
   '[translate k1], [translate k2]'

map translate [k1] [k2] [k3] =>
   '[translate k1], [translate k2], [translate k3]'

map translate [k1] [k2] [k3] [k4] =>
   '[translate k1], [translate k2], [translate k3], [translate k4]'



map mk binding:
   mods        : [mods],               | String of comma separated values (e.g. '"Control","Shift"')
   key         : [key:ident],          | String (e.g. 'e' or e)
   action type : [action_type:ident],  | String (e.g. 'Execute' or Execute)
   action      : [action]              | String (e.g. 'notify-send Hii')
=> ''
   ( command: [action_type],
      value: "[action]",
      modifier: \[ [mods] \],
      key: "[key]"
   ),
''

| No mod (e.g. fn keys)
map bind: [key:ident] -> [action] => [mk binding:
   mods: ' ',
   key: [key],
   action type: Execute,
   action: [action]]

| 1 mod
map bind: [m1:ident] [key:ident] -> [action] => [mk binding:
   mods: [translate m1],
   key: [key],
   action type: Execute,
   action: [action]]

| 2 mods
map bind: [m1:ident] [m2:ident] [key:ident] -> [action] => [mk binding:
   mods: [translate m1 m2],
   key: [key],
   action type: Execute,
   action: [action]]


| Tag switching
map bind: [m1:ident] [key:ident] -> tag [n] => [mk binding:
   mods: [translate m1],
   key: [key],
   action type: GotoTag,
   action: [n]]


| Leftwm commands
map bind: [m1:ident] [key:ident] -> leftwm [cmd:ident] => [mk binding:
   mods: [translate m1],
   key: [key],
   action type: [cmd],
   action: ""]

map bind: [m1:ident] [m2:ident] [key:ident] -> leftwm [cmd:ident] => [mk binding:
   mods: [translate m1 m2],
   key: [key],
   action type: [cmd],
   action: ""]

