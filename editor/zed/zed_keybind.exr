map translate mode [mode] => [is mode {
   'n' ? 'Editor && vim_mode == normal',
   'i' ? 'Editor && vim_mode == insert',
   'v' ? 'Editor && vim_mode == visual',
   't' ? 'Terminal',

   'w' ? 'Workspace',
   'WorkspaceOrAgent' ? 'Workspace || AgentPanel',

   'nv' ? 'Editor && (vim_mode == normal || vim_mode == visual)',

   | Default case
   _ ? mode
}]


|| Top level entry point
map file [mappings]
=> 
'''\
\[
[mappings]\
\]
'''

map mode [m:ident] [keybinds]
=>
''\t{"context":"[translate mode m]","bindings":{
[keybinds]
\t}},
''

map bind [keys] -> [action]
=>
   '\t\t"[keys]":[action],'


|-  Actions  -|

|| Run a zed command (e.g. `file_finder::Toggle`)
map zed [namespace:ident]::[action:ident]
=> '"[namespace]::[action]"'

|| Run a zed `vim::*` command (e.g. `vim::Up`)
map vim [action:ident]
=> '"vim::[action]"'

|| Run a zed `vim::*` command, pass an additional option
map vim [action:ident] [opt:ident]=[value]
=> '\[ "vim::[action]",{"[opt]":[value]}]'

|| Send keys
map keys [keys]
=> '\[ "workspace::SendKeystrokes","[keys]"\]'

