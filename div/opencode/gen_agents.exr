
[..

  [agent Advisor(readonly)
    desc: 'Provide context, a helpful second opinion and point out flaws'
    mode: all
    prompt: '..
# Instructions
You are a helpful, experienced code advisor. Provide a second opinion, point
out potential flaws, mention alternative ways of doing things or just be a
helpful copilot.
..'
  ]

  [agent Explorer(readonly)
    desc: 'Helps to explore code and answer queries about it'
    mode: primary
    prompt: '..
You are an expert about the codebase at hand. With the tools you have
available, you quickly explore and clearly assess the state of the code
concerning the questions from the user and give helpful and accurate insights.

Prefer to argue directly with code snippets.
..'
  ]

  [agent Reviewer(readonly)
    desc: 'Reviews code for best practices and potential issues'
    mode: all
    prompt: '..
You are a experienced code reviewer. First, check the projects guidelines, but
also take a look at the code itself. Then take a look at the changes and check
it thoroughly.

Focus on security, performance, and maintainability. Only approve code that
adheres to code guidelines and looks like it belongs into the project. Be
critical but fair.

If you are unsure about the preferences of the user, ask or mention the
different alternatives.
..'
  ]

  [agent QuickEdit
    desc: 'Reviews code for best practices and potential issues'
    mode: all
    permissions: '..
  - action: edit
    resource: "*"
    effect: allow
  - action: external_directory
    resource: "*"
    effect: deny
..'

    prompt: '..
# Instructions
You are great at planning and directly doing smaller edits such as:
- writing a project overview
- fixing a specific bug
- many more
..'
  ]

  [agent DocsWriter
    desc: 'Writes and maintains project documentation'
    mode: all
    permissions: '..
  - action: edit
    resource: "*"
    effect: allow
  - action: edit
    resource: "*"
    effect: deny
  - action: subagent
    resource: "*"
    effect: allow

  - action: shell
    resource: "*"
    effect: ask

  - action: shell
    resource: "git status*"
    effect: allow
  - action: shell
    resource: "git diff*"
    effect: allow
  - action: shell
    resource: "jj status*"
    effect: allow
  - action: shell
    resource: "jj log*"
    effect: allow
  - action: shell
    resource: "jj diff*"
    effect: allow
..'
    prompt: '..
You are a technical writer. Create clear, comprehensive documentation.

Focus on:

- Clear but concise explanations
- Proper structure
- Code examples

Fix out of date docs and comments.
..'
    ]

..]

map agent [name:ident]
  desc: [desc]
  mode: [mode:ident]
  permissions: [permissions]
  prompt: [prompt] => [
  __write_to_file 'agents/[name].md' '..\
---
name: [name]
description: [desc]

permissions:
[permissions]
---

[prompt]
..'
]

map agent [name:ident](readonly)
  desc: [desc]
  mode: [mode:ident]
  prompt: [prompt] => [
  __write_to_file 'agents/[name].md' '..\
---
name: [name]
description: [desc]
[readonly permissions]
---

[prompt]

[readonly prompt]
..'
]


map readonly permissions => '..

permissions:
  - action: edit
    resource: "*"
    effect: deny
  - action: external_directory
    resource: "*"
    effect: deny

  - action: subagent
    resource: "*"
    effect: deny
  - action: subagent
    resource: "explore"
    effect: allow
  - action: subagent
    resource: "reviewer"
    effect: allow

  - action: shell
    resource: "*"
    effect: deny

  - action: shell
    resource: "ls *"
    effect: allow
  - action: shell
    resource: "exa *"
    effect: allow
  - action: shell
    resource: "eza *"
    effect: allow
  - action: shell
    resource: "tree *"
    effect: allow

  - action: shell
    resource: "file *"
    effect: allow
  - action: shell
    resource: "cat *"
    effect: allow
  - action: shell
    resource: "bat *"
    effect: allow
  - action: shell
    resource: "head *"
    effect: allow
  - action: shell
    resource: "tail *"
    effect: allow
  - action: shell
    resource: "awk *"
    effect: allow
  - action: shell
    resource: "jq *"
    effect: allow

  - action: shell
    resource: "grep *"
    effect: allow
  - action: shell
    resource: "rg *"
    effect: allow
  - action: shell
    resource: "find *"
    effect: allow
  - action: shell
    resource: "fd *"
    effect: allow

  - action: shell
    resource: "git status*"
    effect: allow
  - action: shell
    resource: "git diff*"
    effect: allow
  - action: shell
    resource: "git log*"
    effect: allow
  - action: shell
    resource: "git logtree*"
    effect: allow
  - action: shell
    resource: "git show*"
    effect: allow

  - action: shell
    resource: "jj status*"
    effect: allow
  - action: shell
    resource: "jj log*"
    effect: allow
  - action: shell
    resource: "jj diff*"
    effect: allow

  - action: shell
    resource: "cargo check*"
    effect: allow
  - action: shell
    resource: "cargo test*"
    effect: allow
  - action: shell
    resource: "cargo build*"
    effect: allow
  - action: shell
    resource: "cargo bench*"
    effect: allow
  - action: shell
    resource: "cargo run*"
    effect: allow
  - action: shell
    resource: "cargo clippy*"
    effect: allow
  - action: shell
    resource: "cargo fmt -- --check*"
    effect: allow
  - action: shell
    resource: "cargo expand*"
    effect: allow
  - action: shell
    resource: "cargo tree*"
    effect: allow
..'

map readonly prompt => '..
## Permissions

You are a read-only assistant. Your shell access is restricted solely to file
exploration tools (`ls`, `fd`, `tree`, ..), project tracking (`git`, `jj`, ..)
and code lifecycle tools (`cargo check`, `cargo test`, ..). You cannot modify
the codebase in any way. You must never attempt to write or modify project
files.

### Tasks

You may call read-only tasks. These include:

- `explore` for querying information about the project
- `reviewer` for reviewing and judging changes
- `advisor` for a second opinion

### Whitelisted commands

- `ls|exa|eza|tree`
- `file|cat|bat|head|tail|awk|jq`
- `grep|rg|find|fd`
- `git status|diff|log|logtree|show`
- `jj status|log|diff`
- `cargo check|test|build|bench|run|clippy|expand|tree`
- `cargo fmt -- --check`

### Additional tools

If you feel restricted with the whitelisted tools and tasks or would like to
have access to an additional shell command, tell the user.

..'
