		 // Terminal

		 // Layout
		 (command: NextLayout, value: "", modifier: ["modkey", "Control"], key: "e"),
		 (command: PreviousLayout, value: "", modifier: ["modkey", "Control"], key: "n"),
		 (command: SetMarginMultiplier, value: "0", modifier: ["modkey", "Shift"], key: "0"),

		 // System
		 (command: SoftReload, value: "", modifier: ["Mod4", "Shift"], key: "r"),
		 (command: SoftReload, value: "", modifier: ["Mod1", "Shift"], key: "Return"),
		 (command: Execute, value: "loginctl kill-session $XDG_SESSION_ID", modifier: ["modkey", "Shift"], key: "x"),
		 (command: Execute, value: "i3lock -c 000000", modifier: ["modkey"], key: "z"),

		 // Fn-key functions
		 // TODO: audio


		 //-------- Keyboard layout --------//
		 // ctrl shift alt + space --> standard us
		 (command: Execute, value: "setxkbmap us", modifier: ["Control", "Shift", "Mod1"], key: "space"),
		 (command: Execute, value: "setxkbmap us colemak", modifier: ["Control","Shift","Mod4"], key: "space"),

		 //-------- Monitor configuration --------//

		 // ctrl shift alt + 0 --> Turn off default monitor
		 (command: Execute, value: "xrandr --output eDP-2 --off", modifier: ["Control", "Shift", "Mod1"], key: "0"),

		 // ctrl shift alt + 1 --> Default main monitor
		 (command: Execute, value: "xrandr --output eDP-2 --mode 3200x2000 -r 60", modifier: ["Control", "Shift", "Mod1"], key: "1"),

		 // ctrl shift alt + 2 --> Work layout (Full-HD monitor on the right)
		 (command: Execute, value: "xrandr --output HDMI-1-0 --mode 1920x1080 --right-of eDP-2", modifier: ["Control", "Shift", "Mod1"], key: "2"),

		 // ctrl shift alt + 3 --> Home layout (WQHD monitor)
		 (command: Execute, value: "xrandr --output HDMI-1-0 --mode 3440x1440", modifier: ["Control", "Shift", "Mod1"], key: "3"),

		 // ctrl shift alt + 4 --> 165Hz
		 (command: Execute, value: "xrandr --output eDP-2 --mode 3200x2000 -r 165", modifier: ["Control", "Shift", "Mod1"], key: "4"),


		 //-------- Windows --------//

		 (command: MoveWindowUp, value: "", modifier: ["Mod1", "Shift"], key: "n"),
		 (command: MoveWindowUp, value: "", modifier: ["Mod1", "Shift"], key: "e"),
		 (command: MoveWindowDown, value: "", modifier: ["Mod1", "Shift"], key: "i"),
		 (command: MoveWindowDown, value: "", modifier: ["Mod1", "Shift"], key: "o"),
		 // (command: MoveWindowTop, value: "", modifier: ["Mod1", "Shift"], key: "space"),

		 // (command: FocusWindowUp, value: "", modifier: ["Mod1"], key: "n"),
		 // (command: FocusWindowUp, value: "", modifier: ["Mod1"], key: "e"),
		 // (command: FocusWindowDown, value: "", modifier: ["Mod1"], key: "i"),
		 // (command: FocusWindowDown, value: "", modifier: ["Mod1"], key: "o"),

		 (command: DecreaseMainSize, value: "2", modifier: ["Mod4", "Shift"], key: "n"),
		 (command: IncreaseMainSize, value: "2", modifier: ["Mod4", "Shift"], key: "o"),


		 //-------- Workspaces --------//

		 (command: FocusWorkspaceNext, value: "", modifier: ["Mod1", "Control"], key: "o"),
		 (command: FocusWorkspacePrevious, value: "", modifier: ["Mod1", "Control"], key: "n"),
		 (command: MoveWindowToPreviousWorkspace, value: "", modifier: ["Mod1", "Control", "Shift"], key: "n"),
		 (command: MoveWindowToNextWorkspace, value: "", modifier: ["Mod1", "Control", "Shift"], key: "o"),


		 //-------- Tags --------//

		 (command: MoveToLastWorkspace, value: "", modifier: ["modkey", "Shift"], key: "w"),
		 (command: SwapTags, value: "", modifier: ["modkey"], key: "w"),

		 (command: GotoTag, value: "1", modifier: ["modkey"], key: "1"),
		 (command: GotoTag, value: "2", modifier: ["modkey"], key: "2"),
		 (command: GotoTag, value: "3", modifier: ["modkey"], key: "3"),
		 (command: GotoTag, value: "4", modifier: ["modkey"], key: "4"),
		 (command: GotoTag, value: "5", modifier: ["modkey"], key: "5"),
		 (command: GotoTag, value: "6", modifier: ["modkey"], key: "6"),
		 (command: GotoTag, value: "7", modifier: ["modkey"], key: "7"),
		 (command: GotoTag, value: "8", modifier: ["modkey"], key: "8"),
		 (command: GotoTag, value: "9", modifier: ["modkey"], key: "9"),

		 (command: MoveToTag, value: "1", modifier: ["modkey", "Shift"], key: "1"),
		 (command: MoveToTag, value: "2", modifier: ["modkey", "Shift"], key: "2"),
		 (command: MoveToTag, value: "3", modifier: ["modkey", "Shift"], key: "3"),
		 (command: MoveToTag, value: "4", modifier: ["modkey", "Shift"], key: "4"),
