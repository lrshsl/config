    layout_mode: Tag,
    insert_behavior: Bottom,
    scratchpad: [
        (
            name: "Ghostty",
            value: "ghostty",
            args: None,
            x: 860, y: 50,
            height: 600, width: 1600
         ),
    ],
    window_rules: [
       ( window_title: "dropdown-scratch-terminal", spawn_floating: true ),
       ( window_class: "retype", spawn_floating: true ),
       ( window_class: "Godot_Editor", spawn_floating: false ),
    ],
    disable_current_tag_swap: true,
    disable_tile_drag: false,
    disable_window_snap: true,
    focus_behaviour: Sloppy,
    focus_new_windows: true,
    single_window_border: false,
    sloppy_mouse_follows_focus: true,
    create_follows_cursor: None,
    auto_derive_workspaces: true,
    disable_cursor_reposition_on_resize: false,
    window_hiding_strategy: MoveOnly,
    keybind: [


		 //-------- Shortcuts --------//

		 // Launcher
       
   ( command: Execute,
      value: "rofi -show drun",
      modifier: [ "Mod1" ],
      key: "space"
   ),


   ( command: Execute,
      value: "rofi -show run",
      modifier: [ "Mod1", "Shift" ],
      key: "space"
   ),


   ( command: Execute,
      value: "ghostty",
      modifier: [ "Mod1" ],
      key: "Return"
   ),


   ( command: Execute,
      value: "xfce4-terminal",
      modifier: [ "Mod4" ],
      key: "Return"
   ),


   ( command: Execute,
      value: " xfce4-terminal --drop-down --title 'dropdown-scratch-terminal' ",
      modifier: [ "Mod1" ],
      key: "t"
   ),


   ( command: ToggleScratchPad,
      value: "Ghostty",
      modifier: [ "Control", "Shift", "Mod1" ],
      key: "t"
   ),


   ( command: Execute,
      value: "xkill",
      modifier: [ "Mod4" ],
      key: "Escape"
   ),


   ( command: Execute,
      value: " polybar-msg cmd toggle >/dev/null 2>&1 || polybar -c $HOME/.config/leftwm/themes/current/polybar.ini mainbar &> /dev/null & ",
      modifier: [ "Mod4" ],
      key: "b"
   ),


   ( command: Execute,
      value: "firefox",
      modifier: [ "Control", "Shift", "Mod1" ],
      key: "b"
   ),


   ( command: Execute,
      value: "neovide",
      modifier: [ "Control", "Shift", "Mod1" ],
      key: "period"
   ),


   ( command: Execute,
      value: "brightnessctl set +5%",
      modifier: [   ],
      key: "XF86MonBrightnessUp"
   ),


   ( command: Execute,
      value: "brightnessctl set 5%-",
      modifier: [   ],
      key: "XF86MonBrightnessDown"
   ),


   ( command: Execute,
      value: "wpctl set-volume @DEFAULT_SINK@ 0.1+",
      modifier: [   ],
      key: "XF86AudioRaiseVolume"
   ),


   ( command: Execute,
      value: "wpctl set-volume @DEFAULT_SINK@ 0.1-",
      modifier: [   ],
      key: "XF86AudioLowerVolume"
   ),


   ( command: Execute,
      value: "wpctl set-mute @DEFAULT_SINK@ toggle",
      modifier: [   ],
      key: "XF86AudioMute"
   ),


   ( command: CloseWindow,
      value: "",
      modifier: [ "Mod1" ],
      key: "c"
   ),


   ( command: ToggleMaximized,
      value: "",
      modifier: [ "Control", "Shift", "Mod1" ],
      key: "m"
   ),


   ( command: ToggleFullScreen,
      value: "",
      modifier: [ "Mod4" ],
      key: "m"
   ),


   ( command: ToggleFloating,
      value: "",
      modifier: [ "Mod4", "Shift" ],
      key: "m"
   ),


   ( command: FocusWindowUp,
      value: "",
      modifier: [ "Mod1" ],
      key: "n"
   ),


   ( command: FocusWindowUp,
      value: "",
      modifier: [ "Mod1" ],
